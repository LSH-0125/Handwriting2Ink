# Demo configuration example. Copy to .env and fill in. .env is gitignored.

# Local demo can use SQLite. For Postgres use postgresql://... or
# postgresql+psycopg://... ; app/db.py normalizes either form.
DATABASE_URL=sqlite:///./h2i.db

# Bearer token the Windows worker uses for /api/worker/*
WORKER_TOKEN=change-me

# Access key for the client API (/api/jobs*).
# Leave EMPTY for a local LAN demo - then no key is required.
# Set it for a public deployment (Railway); the iPad then opens
#   https://<host>/?k=<this value>
CLIENT_KEY=

# Where uploads and pipeline output are written.
STORAGE_BASE=storage/jobs
